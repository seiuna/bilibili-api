{
  "name": "@seiuna/bilibili-api",
  "version": "1.0.1",
  "description": "类型安全的 Bilibili API 客户端 — 扫码登录、评论区、私信、用户空间、图片上传，支持自动凭证刷新与 Generator 分页",
  "keywords": [
    "bilibili",
    "b站",
    "api-client",
    "login",
    "qrcode",
    "comment",
    "chat",
    "upload",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seiuna/bilibili-api.git"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@types/node": "^25.6.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.2"
  },
  "scripts": {
    "build": "tsup index.ts --format esm --dts",
    "dev": "tsup index.ts --format esm --dts --watch",
    "run-dev": "tsx index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}