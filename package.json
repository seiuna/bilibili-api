{
  "name": "@seiuna/bilibili-api",
  "version": "1.0.3",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup index.ts --format esm --dts",
    "dev": "tsup index.ts --format esm --dts --watch",
    "demo": "tsx scripts/auto-reply.ts",
    "full-test": "tsx test.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/qrcode": "^1.5.5",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^3.1.3"
  }
}
