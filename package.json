{
  "name": "@seiuna/bilibili-api",
  "version": "1.1.0",
  "description": "类型安全的 Bilibili API 客户端 — 扫码登录、评论区、私信、用户空间、图片上传，支持自动凭证刷新与 Generator 分页",
  "keywords": [
    "bilibili",
    "b站",
    "api-client",
    "login",
    "qrcode",
    "comment",
    "chat",
    "upload",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@types/node": "^25.6.0",
    "log4js": "^6.9.1",
    "qrcode": "^1.5.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsup index.ts --format esm --dts",
    "dev": "tsup index.ts --format esm --dts --watch",
    "demo": "tsx scripts/auto-reply.ts",
    "full-test": "tsx test.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  }
}
